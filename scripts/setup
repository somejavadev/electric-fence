#!/usr/bin/env bash
# Set up the development environment: Home Assistant, the test tooling, the
# panel build, and the symlink that makes the integration visible to Home
# Assistant in .devcontainer/config.
#
# Installs the Home Assistant release pinned in requirements_ha.txt. HA_REF
# picks a Home Assistant Core ref (a tag or branch) instead, installed from git.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ -n "${HA_REF:-}" ]]; then
  scripts/ci_install_ha.sh "$HA_REF"
else
  python -m pip --disable-pip-version-check install -r requirements_ha.txt -r requirements_test.txt
fi

# The panel must be built before Home Assistant starts: the static path is
# registered once, with the folder as it exists at startup.
(cd frontend && npm ci && npm run build)

mkdir -p .devcontainer/config/custom_components
ln -sfn ../../../custom_components/electric_fence .devcontainer/config/custom_components/electric_fence
